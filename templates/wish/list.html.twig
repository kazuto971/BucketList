{% extends 'base.html.twig' %}

{% block title %}Liste des wishes{% endblock %}

{% block body %}
    <section class="wishes-list">
        <h2>All wishes!</h2>
        {% for wish in wishes %}
            <article>
                <a href="{{ path('wish_detail', {id: wish.id}) }}"
                   title="View this wish in details">
                    {{ wish.titre }}
                    {{ wish.category.name }}
                </a>
            </article>
        {% endfor %}
    </section>
{% endblock %}

